{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2024"],
        "types": ["node"],
        "resolveJsonModule": true,
        "allowImportingTsExtensions": false,
        "erasableSyntaxOnly": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src/**/*.ts", "vitest.config.ts"]
}
